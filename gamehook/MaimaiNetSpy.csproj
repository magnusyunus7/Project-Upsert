<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MaimaiNetSpy —— MelonLoader Mod：hook 舞萌DX 游戏网络层做实时拦截
    ==========================================================================
    目标框架必须与游戏/MelonLoader 一致：net472（MonoBleedingEdge + MelonLoader 0.6.4）
    构建：dotnet build -c Release
    产物：bin/Release/net472/MaimaiNetSpy.dll  -> 复制到 D:\SDGB2026\Package\Mods\
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MaimaiNetSpy</AssemblyName>
    <RootNamespace>MaimaiNetSpy</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <!-- 不生成 apphost / 不需要运行时配置 -->
    <UseAppHost>false</UseAppHost>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <!-- 允许引用 net472 参考程序集 -->
    <AutomaticallyUseReferenceAssemblyPackages>true</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

  <!-- 游戏程序集与 MelonLoader 的引用（全部 Private=false，不复制到输出） -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>D:\SDGB2026\Package\MelonLoader\net35\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>D:\SDGB2026\Package\MelonLoader\net35\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>D:\SDGB2026\Package\Sinmai_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>D:\SDGB2026\Package\Sinmai_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>D:\SDGB2026\Package\Sinmai_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>D:\SDGB2026\Package\Sinmai_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AMDaemon.NET">
      <HintPath>D:\SDGB2026\Package\Sinmai_Data\Managed\AMDaemon.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ChimeLib.NET">
      <HintPath>D:\SDGB2026\Package\Sinmai_Data\Managed\ChimeLib.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

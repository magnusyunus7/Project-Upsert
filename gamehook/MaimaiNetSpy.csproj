<Project Sdk="Microsoft. NET. Sdk">

 <!--
  MaimaiNetSpy — MelonLoader Mod: hook DX networktime
  ==========================================================================
  Must be associated with/MelonLoader Match: net472(MonoBleedingEdge + MelonLoader 0.6.4)
: dotnet build -c Release
: bin/Release/net472/MaimaiNetSpy. dll -> to D:\SDGB2026\Package\Mods\
 -->

 <PropertyGroup>
  <TargetFramework>net472</TargetFramework>
  <AssemblyName>MaimaiNetSpy</AssemblyName>
  <RootNamespace>MaimaiNetSpy</RootNamespace>
  <LangVersion>latest</LangVersion>
  <Nullable>disable</Nullable>
  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  <Version>1.0.0</Version>
  <!-- No apphost / Not requiredtime -->
  <UseAppHost>false</UseAppHost>
  <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  <!-- use net472 -->
  <AutomaticallyUseReferenceAssemblyPackages>true</AutomaticallyUseReferenceAssemblyPackages>
 </PropertyGroup>


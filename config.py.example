#
# - Why the script needs it:
#   UpsertUserChargelogApi(purchase tickets Tickets)of userChargelog. price Take is
#   **ticket. creditNum(ofusetimesnumber)**, No GetGameChargeApi inof money price:
#     source/Assembly-CSharp/Net. VO. Mai2/VOExtensions. cs:410
#       result. price = ticket. creditNum;
#
# ticketKind Meaning(Ticket. xml inof):
#   1=Paid(Paid, Can be bought at the machine) 2=Event 3=Free 4=Link 5=ShopWeekly 6=ShopChara
# - TICKET_CREDIT_NUM / TICKET_NAMES / PAID_TICKET_IDS /
#  TICKET_VALID_HOUR_OFFSET / TICKET_VALID_DAYS
#  moved to api/upsert_user_chargelog. py

#: Ticket gate(and UpsertUserAll Same, defaultNo)
UPSERT_CHARGELOG_CONFIRM = False
# =============================================================================
# Four,- UpsertUserAll upcoming song data uploads
# =============================================================================

# -*- coding: utf-8 -*-
"""
config. py — DX network script · configuration item
================================================================================

-- this is **file**. Make a copy before first use:

    cp config. py. example config. py     # Linux / macOS
    copy config. py. example config. py    # Windows

  After completing the required Section 2 "machine state and store" of 6 values, Otherwise, the script sends out a request
  another machine's ID, the server will.

  - config. py at. gitignore in — It belongs to your private configuration, Don't submit.
================================================================================

file contents **user-editable** content, The rest of the protocol constants are written in their respective scripts.

Split into six pieces:
 1. network and encryption constants(AES Key, Protocol Version, server)
 2. machine state and store(Keychip, Area, Store)
 3. QR login constants(aimedb)
 4. - UpsertUserAll upcoming song data uploads(defaultTake source/2026-10-05. log real-machine sample)
 5. UpsertUserAll Safety gate
 6. log

all logging, review the source first before changing.
"""

# =============================================================================
# One, network and encryption constants
# =============================================================================

# - BASE_URL / AES_KEY / AES_IV / OBFUSCATE_PARAM moved to api/maimai_net. py
# --- packet ---
# Basis: source/Assembly-CSharp/Net/NetHttpClient. cs:69 DefaultHttpHeaderEncryption = "1.55"
#    (request header Mai-Encoding value of;1.56 ROM the actual test is still sent 1.55)
MAI_ENCODING = "1.55"

# --- time (seconds) ---
# Basis: source/Assembly-CSharp/Net/NetConfig. cs:7-11
TIMEOUT_MS = 10000     # interface
TIMEOUT_LONG_MS = 60000   # login / settlement upload


# =============================================================================
# Two, machine state and store
# =============================================================================

# Client ID (Keychip short Value)
# Basis: source/Assembly-CSharp/Net. Packet. Mai2/PacketGetGameSetting. cs:23
#    clientId = AMDaemon. System. KeychipId. ShortValue
# Measured: real-machine login clientId Constant equals Keychip short Value
# - Morphology = 15 Bit Keychip After removing the hyphen **ago 11 Bit** (Uppercase hex).
CLIENT_ID = ""         # -- Required: Shape like "A63E01C3047"

# Area ID / Store ID
# Basis: source/Assembly-CSharp/Net. Packet. Mai2/PacketUserLogin. cs:24-25
#    regionId = Auth. RegionCode; placeId = Auth. LocationId
# Measured: real-machine loginof regionId / placeId Consistent with the location of the machine
REGION_ID = 0          # -- Required: Your area ID
PLACE_ID = 0          # -- Required: Your store ID

# Keychip ID (machine state Unique, Full format with hyphens)
# -- this isofmachine state, Do not share this value; Fill in the wrong server and it will be rejected.
# Basis: source/Assembly-CSharp/Manager/ChimeReaderManager. cs:250
#    KeychipID = AMDaemon. System. KeychipId. Value
# - group = CLIENT_ID offirst 4 digits + "-" + CLIENT_ID remaining digits plus + PLACE_ID
#   Example: CLIENT_ID "A63E01C3047" + PLACE_ID 1007 -> "A63E-01C30471007"
#  So it's made up of the two values above **text**, Don't manipulate.
KEYCHIP_ID = (CLIENT_ID[:4] + "-" + CLIENT_ID[4:] + str(PLACE_ID)) if CLIENT_ID else ""

# Store Name / Area Name
#
# - Why it had to be filled in manually before: **server none Any interface return times Store Name**.
#  source/2026-10-05. log All Responses:
#   - GetGameSettingApi Only Returns gameSetting, noFirst name
#   - GetUserDataApi of lastPlaceName back is null
#   - GetUserRegionApi Only Returns regionId/playCount/created
#  Store name from machine local AMDaemon:
#   source/AMDaemon. NET/AMDaemon/Allnet/Auth. cs:33 LocationName <- allnet_Auth_getLocationName()
#  ismachinetime ALL. Net Issueof, client locally., Will not request from the game server.
#
# -- currentatNouse: python authv1. py <YourKeychip> will ask directly ALL. Net
#  the server musttimes name / region_name0. putBelowof AUTHV1_WRITE_CONFIG,
#  It also automatically writes the results back config. py.
PLACE_NAME = ""         # -- Required: Store Name
REGION_NAME = ""        # -- Required: Area Name


# --- authv1 Write back switch ---
#
# authv1. py (Keychip -> machine state) check to result After, is No **write-back config. py**.
#
#  True: each check After successful, put CLIENT_ID / REGION_ID / PLACE_ID /
#      PLACE_NAME / REGION_NAME Five values rewritten into config. py.
#      (KEYCHIP_ID isValue, will automatically change with it, No need to write.)
#      changes create a backup file config. py. bak, Write a bad configuration.
#  False: Only print results, immovable config. py. (default, Safety)
#
# Command line can be temporarily overwritten:--write Force Write / --no-write Force Do Not Write.
AUTHV1_WRITE_CONFIG = False


# =============================================================================
# Three, QR login constants(aimedb)
# =============================================================================
#
# Basis: source/ChimeLib. NET/ChimeLib/NET/COMM/CCommGetUserData. cs
#    + docs/DX_QR login. md

# - aimedb / QR Constant has sank to api/chime. py
# =============================================================================
# Three bis,- feature tickets(Ticket)Master Data
# =============================================================================
#
# Basis: Master Data
#     D:\SDGB2026\Package\Sinmai_Data\StreamingAssets\A000\ticket\ticketXXXXXX\Ticket. xml

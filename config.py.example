PLAY_CATEGORY_INDEX = 2022
PLAY_MUSIC_INDEX = 10      # userExtend. musicIndex
PLAY_EXTRA_FLAG = 1721     # userExtend. extraFlag

# --- this gameUseofSnapshot(characterId1..5 / Level / Awakening)---
#
# - semantic: **play time** of Snapshot Value, Don't add experience — this One.
#  (settlementAfteroflevelat upsertUserAll. userCharacterList in, thatplaceonly +text)
#  real machineEmpirical(source/2026-10-05. log:123 Same message):
#    userPlaylogList[0]. characterLevel1..5 = 3800/4455/134/134/134 ← Snapshot(playago)
#    upsertUserAll. userCharacterList    = 3801/4456/135/135/135 ← settlementAfter
#
# --**No need to change here**: main. py will be called derive_play_characters(snapshot),
#  directlyFromserver-issuedof userData. charaSlot + userCharacterList outplayagolevel,
#  and overwrite this configuration. Only can't get a snapshot(batch packets)timeonlyFallback tothisin.
#
# defaultValue = real machine charaSlot [395, 101, 400402, 400401, 200401] ofplayagolevel
# --- this gameconsume ---
# - playCredit semantic(VOExtensions. cs:838-845):
#   playCredit = Credit. GameCostEnoughPlay()(text) + TicketManager. GetTicketCredit(useTicketId)
#  i. e."thisone gameof credit", Not a balance, is not track count. real-machine sample = 1.
PLAY_CREDIT = 1
# - -1 = Don't use tickets. Basis TicketManager. cs:47 Initialization _useTicketId[i] = -1;
#  GetTicketCredit(-1) in GetTicket(-1) returntimes null -> returntimes 0, That is, no ticket is not converted credit.
PLAY_USE_TICKET_ID = -1
PLAY_MODE = 0          # 0=text
PLAY_IS_TUTORIAL = False
PLAY_IS_EVENT_MODE = False
PLAY_IS_NEW_FREE = False
PLAY_IS_FREEDOM_MODE = False

# --- machine state count number (- no From server, Can only be filled in manually) ---
#
# Basis: source/Assembly-CSharp/Net. VO. Mai2/VOExtensions. cs:881
#    result. playCount = Backup. localParameter. playCount
#   this ismachine state**text**ofplaycountnumber, Any Get interfaceallNowill return,
#   So it can neither be rolled out nor corrected by the server — Misfilling is just a statistic.
# Pick a value = themachine stateWhendays/ofcountplaygamenumber(eachone game +1).
# real machineMeasured:19:21 thatone game = 9,22:31 thatone game = 10.
# - PLAY_LOCAL_PLAY_COUNT Constantly 2(moved to api/upsert_user_all. py)
# --- - playSpecial inof "CalcSpecialNum"(machine stateBit)---
#
# Basis: source/Assembly-CSharp/Manager/GameManager. cs:332-378
#    source/Assembly-CSharp/Net. VO. Mai2/VOExtensions. cs:846-855
#
#  playSpecial = Bit inversion32( Random. Range(1,1037933) * 2069 + CalcSpecialNum() )
#
#  CalcSpecialNum() is**pressBitor**Outgoing machine feature mask, BitMeaning(source codeHara):
#    0x001 SpecialAP          (text/AP)
#    0x002 IsAutoPlay()
#    0x004 Win32. getRawInputDeviceCount of keyboard > 0
#    0x008 Ibid. mouse > 0
#    0x010 config. IsAutoPlay / IsDebugDisp / IsAllOpen
#    0x020 AMDaemon. System. IsDevelop
#    0x040! SystemInfo. deviceName. Contains("ACA")    ← real machine is ACA, theBitfor 0
#    0x080! graphicsDeviceName. Contains("GeForce GTX")  ← real machine is GTX, theBitfor 0
#    0x100! processorType. Contains("Core(TM) i3-8100")  ← real machine is i3-8100, theBitfor 0
#    0x400 noitemBit(source code GameManager. cs:375)      ← - Constantly 1
#
#  - real machineMeasured(gamehook to CalcSpecialNum calluse):
#     [CalcSpecialNum] = 1024  (SpecialAP=False IsFreedomMode=False)
#    1024 = 0x400, i. e. divide by"noitemBit"thatOneBitAllfor 0 — currentisOneStagestandard ACA machine state.
#
#  - Reverse inference validation: real machine playSpecial = 892014272
#     Bit inversion32(892014272) = 57726124 = 27900 * 2069 + 1024
#     The remainder is just right 1024, with caught CalcSpecialNum Exact match.
#
#  change 0 No errors, But playSpecial ofBitmodeNoreal machinethat.
# - PLAY_SPECIAL_NUM = 1024 moved to api/upsert_user_all. py
# --- userTotal Play CountIncrement ---
#
# - default 0 = **userData. playCount / currentPlayCount allUnchanged**(this gameDo not countTotal number of times).
#  Want to replicate the real machine"+1"Change to 1.
#
#  Why was the default changed to 0:
#   playCount isof**Total Play Count**, isVisibleofsystemcountValue;
#  "Score Upload"timeNot requiredchange, Stay consistent and safer before uploading.
#  - change 0 Side effects after:"post-upload validation"Can't rely on it anymore playCount isNo +1 Judgment,
#   will be automatically switched to lastPlayDate isNoupdateJudgment(verify_upsert_landing).
PLAY_USER_PLAY_COUNT_GAIN = 0

# --- trackplaycountIncrement ---
#
# - default 0 = this game**No change**thetrackofplaycount.
#  -- notesemantic: is"itemPassing on, countUnchanged",**No**"Do not return this node".
#   Measured(Same code, Same account, The only difference is this node):
#     userMusicDetailList Callback 1 item -> returnCode=1 And playCount of +1(post-upload)
#     userMusicDetailList leave blank   -> returnCode=1 But playCount immovable(**post-upload**)
#   So"I don't want the music playCount Increase"Must lean against the handle**Increment**0,
#   andNoputnodesempty — The latter will cause the entire package to be silently discarded by the server.
#
#  Want to replicate the real machine"thechart playCount +1"Change to 1.
PLAY_MUSIC_PLAY_COUNT_GAIN = 0

# --- Map Progress Increment ---

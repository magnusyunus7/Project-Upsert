PLAY_MAX_COMBO = 0
PLAY_TOTAL_COMBO = 655     # thechart note Total(= Sum of each type of judgment number)
PLAY_MAX_SYNC = 0
PLAY_TOTAL_SYNC = 0
PLAY_COMBO_STATUS = 0      # 0=no 1=Quan Lian
PLAY_SYNC_STATUS = 0

PLAY_FAST_COUNT = 0
PLAY_LATE_COUNT = 0

